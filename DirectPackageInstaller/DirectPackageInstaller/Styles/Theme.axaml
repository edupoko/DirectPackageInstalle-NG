<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Estilos comuns do app (referência visual: pasta inspiracoes/).
        Cantos retos, linhas finas, rótulos em monoespaçada e fundo cinza escuro.
        Os tokens de cor ficam em App.axaml (Application.Resources).
    -->

    <!-- Botão padrão: contorno fino, fundo transparente, cantos retos -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- A cor do texto e dos ícones vem do Foreground do próprio botão -->
    <Style Selector="Button:pointerover">
        <Setter Property="Foreground" Value="#0B0B0D"/>
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="Foreground" Value="#0B0B0D"/>
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Foreground" Value="#6A6A72"/>
    </Style>

    <!-- Hover: fundo branco, texto e ícone escuros -->
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#0B0B0D"/>
    </Style>

    <!-- Pressionado: branco levemente acinzentado -->
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#D0D0D4"/>
        <Setter Property="BorderBrush" Value="#D0D0D4"/>
        <Setter Property="Foreground" Value="#0B0B0D"/>
    </Style>

    <!-- Desabilitado -->
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#3A3A3F"/>
        <Setter Property="Foreground" Value="#6A6A72"/>
    </Style>

    <!-- Botão primário: retângulo branco chapado com texto escuro -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#D8D8DC"/>
        <Setter Property="Foreground" Value="#0B0B0D"/>
        <Setter Property="BorderBrush" Value="#D8D8DC"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#BEBEC4"/>
        <Setter Property="Foreground" Value="#0B0B0D"/>
        <Setter Property="BorderBrush" Value="#BEBEC4"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2A2A2D"/>
        <Setter Property="Foreground" Value="#6A6A72"/>
        <Setter Property="BorderBrush" Value="#2A2A2D"/>
    </Style>

    <!-- Botões de janela e de ícone: quadrados, sem contorno -->
    <Style Selector="Button.window">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.window:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="#0B0B0D"/>
    </Style>
    <Style Selector="Button.window:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#D0D0D4"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="#0B0B0D"/>
    </Style>

    <!-- Controles da janela (minimizar, maximizar, fechar): hover cinza sutil e ícone branco -->
    <Style Selector="Button.wincontrol:pointerover">
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.wincontrol:pressed">
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.wincontrol:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#3A3A3D"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.wincontrol:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2A2A2D"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- Fechar: vermelho no hover e ao pressionar -->
    <Style Selector="Button.wincontrol.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#C42B1C"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.wincontrol.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#9E2216"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- Barra de rolagem: 8 px, sem botões de seta, alça reta -->
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="8"/>
        <Setter Property="MinHeight" Value="8"/>
    </Style>
    <Style Selector="ScrollBar /template/ RepeatButton">
        <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!-- Expander: reto e sem preenchimento no cabeçalho -->
    <Style Selector="Expander">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!-- Abas: botões lado a lado; a ativa fica invertida em branco -->
    <Style Selector="Button.tab">
        <Setter Property="Padding" Value="18,7"/>
        <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Margin" Value="0,0,-1,0"/>
    </Style>
    <Style Selector="Button.tab.active">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#0B0B0D"/>
        <Setter Property="BorderBrush" Value="#FFFFFF"/>
    </Style>

    <!-- Barra de progresso: reta, branca sobre trilho cinza -->
    <Style Selector="ProgressBar">
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}"/>
    </Style>

    <!-- Indicador de estado (console): sem contorno, realce discreto no hover e texto sempre claro -->
    <Style Selector="Button.status">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.status:pointerover">
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.status:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#2A2A2D"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <!-- Campos: cantos retos -->
    <Style Selector="TextBox">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!-- Tabela de parâmetros: cabeçalho na paleta cinza (o padrão do tema é preto puro) -->
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
    </Style>

    <!-- Rótulo de seção/estado: monoespaçada, pequena e em cinza -->
    <Style Selector="TextBlock.caption">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <!-- Etiqueta de status: contorno fino com texto monoespaçado -->
    <Style Selector="Border.tag">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>
    <Style Selector="Border.tag > TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- Ícone: traço fino de 16x16 que acompanha a cor do texto -->
    <Style Selector="Path.icon">
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground, FallbackValue=White}"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="StrokeJoin" Value="Round"/>
        <Setter Property="Stretch" Value="None"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Título de seção: monoespaçada e cinza -->
    <Style Selector="TextBlock.section">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Margin" Value="0,18,0,8"/>
    </Style>
</Styles>
