<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Ícones do app: traços simples em grade de 16x16, sem dependência externa.
        Uso: <Path Classes="icon" Data="{StaticResource IconSettings}"/>
        A cor vem do token TextPrimaryBrush (ver Styles/Theme.axaml).
    -->
    <StreamGeometry x:Key="IconSettings">M2,4 H7 M10,4 H14 M2,8 H4 M7,8 H14 M2,12 H9 M12,12 H14 M8.5,2.5 V5.5 M5.5,6.5 V9.5 M10.5,10.5 V13.5</StreamGeometry>
    <StreamGeometry x:Key="IconRestart">M13,8 A5,5 0 1 1 11.5,4.5 M13,2.5 V5.5 H10</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M3,3 L13,13 M13,3 L3,13</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M2,4.5 H6.5 L8,6 H14 V12.5 H2 Z</StreamGeometry>
    <StreamGeometry x:Key="IconCheck">M3,8.5 L6.5,12 L13,4.5</StreamGeometry>
    <StreamGeometry x:Key="IconDownload">M8,2 V10 M4.5,6.5 L8,10 L11.5,6.5 M2.5,13 H13.5</StreamGeometry>
    <StreamGeometry x:Key="IconWarning">M8,2 L14.5,13.5 H1.5 Z M8,6.5 V9.5 M8,11.2 V11.8</StreamGeometry>
    <StreamGeometry x:Key="IconChevronDown">M4,6 L8,10 L12,6</StreamGeometry>
</ResourceDictionary>
