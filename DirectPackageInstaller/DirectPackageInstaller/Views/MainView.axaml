<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DirectPackageInstaller.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DirectPackageInstaller.Views.MainView"
             Foreground="White"
             Background="{DynamicResource AppBackgroundBrush}">
  <Design.DataContext>
    <viewModels:MainViewModel />
  </Design.DataContext>
    <Grid Name="MainViewGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Menu Name="MainMenu" Grid.ColumnSpan="2">
            <MenuItem Header="_Options" Name="OptionsMenu">
                <MenuItem Header="_Proxy Downloads" Name="btnProxyDownload">
                    <MenuItem.Icon>
                        <CheckBox BorderThickness="0" IsChecked="{Binding ProxyMode, Mode=TwoWay}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Segmented Downloads" Name="btnSegmentedDownload" >
                    <MenuItem.Icon>
                        <CheckBox BorderThickness="0" IsChecked="{Binding SegmentedMode, Mode=TwoWay}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Transfer Progress" Name="btnTransferProgress" >
                    <MenuItem.Icon>
                        <CheckBox BorderThickness="0" IsChecked="{Binding ShowTransferProgress, Mode=TwoWay}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_DHCP Server" Name="btnDHCPService" >
                    <MenuItem.Icon>
                        <CheckBox BorderThickness="0" IsChecked="{Binding DHCPService, Mode=TwoWay}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_IP Address" Classes="NoChildFocus">
                    <StackPanel Orientation="Horizontal">
                        <Label Grid.Column="0">PS IP</Label>
                        <TextBox Grid.Column="1" Text="{Binding PS4IP, Mode=TwoWay}"></TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Grid.Column="0">PC IP</Label>
                        <TextBox Grid.Column="1" Text="{Binding PCIP, Mode=TwoWay}"></TextBox>
                    </StackPanel>
                </MenuItem>
                <MenuItem Header="_Debrids">
                    <MenuItem Header="_AllDebrid" Classes="NoChildFocus">
                        <StackPanel Orientation="Horizontal">
                            <Label Grid.Column="0">API Key</Label>
                            <TextBox Grid.Column="1" Text="{Binding AllDebridApiKey, Mode=TwoWay}" Focusable="True"></TextBox>
                        </StackPanel>
                        <MenuItem Header="_Enabled" Padding="10,10,0,10" Name="btnAllDebirdEnabled">
                            <MenuItem.Icon>
                                <CheckBox BorderThickness="0" IsChecked="{Binding UseAllDebrid, Mode=TwoWay}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="_RealDebrid" Classes="NoChildFocus">
                        <StackPanel Orientation="Horizontal">
                            <Label Grid.Column="0">API Key</Label>
                            <TextBox Grid.Column="1" Text="{Binding RealDebridApiKey, Mode=TwoWay}"></TextBox>
                        </StackPanel>
                        <MenuItem Header="_Enabled" Padding="10,10,0,10" Name="btnRealDebirdEnabled">
                            <MenuItem.Icon>
                                <CheckBox BorderThickness="0" IsChecked="{Binding UseRealDebrid, Mode=TwoWay}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="_DebridLink" Classes="NoChildFocus">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="API Key" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Width="150" Text="{Binding DebridLinkApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <MenuItem Header="_Enabled" Padding="10,10,0,10" Name="btnDebirdLinkEnabled">
                            <MenuItem.Icon>
                                <CheckBox BorderThickness="0" IsChecked="{Binding UseDebridLink, Mode=TwoWay}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </MenuItem>
                
                <MenuItem Header="_Restart Server" Name="btnRestartServer"/>
                <MenuItem Header="_Exit" Name="btnExit"/>
            </MenuItem>
            <MenuItem Header="Packages" IsVisible="False" Name="PackagesMenu">
                <Separator></Separator>
                <MenuItem Header="Install _All" Name="btnInstallAll"></MenuItem>
            </MenuItem>
        </Menu>

        <!-- Abas: Biblioteca (grade da pasta) e Pacote (detalhes do arquivo carregado) -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="12,12,12,12">
            <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Button Classes="tab" Classes.active="{Binding ShowLibrary}" Click="TabLibraryClick" Content="{Binding LibraryTabText}"/>
            <Button Classes="tab" Classes.active="{Binding ShowPackage}" Click="TabPackageClick" Content="PACKAGE"/>
            <Button Classes="tab" Classes.active="{Binding ShowHistory}" Click="TabHistoryClick" Content="{Binding HistoryTabText}"/>
            </StackPanel>

            <!-- Estado do console: abre as configurações de rede -->
            <Button Grid.Column="1" Classes="status" Click="ConsoleStatusClick"
                    ToolTip.Tip="{Binding ConsoleStatusTip}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="8" Height="8" Fill="{Binding ConsoleStatusBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConsoleStatusText}" Classes="caption" Margin="0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Barra do Pacote: URL ou caminho e a ação principal -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="12,0,12,12"
              IsVisible="{Binding ShowPackage}">
            <TextBox Grid.Column="0" Name="tbURL" Text="{Binding CurrentURL, Mode=TwoWay}"
                     Watermark="URL or file path" MinHeight="36" Margin="0" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Name="btnLoad" Classes="primary" Height="36" MinWidth="104" Padding="22,0"
                    Margin="8,0,0,0" VerticalAlignment="Center">Open</Button>
        </Grid>

        <!-- Barra da Biblioteca: busca, pasta e ações (só aparece com pasta definida) -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="280,*,Auto,Auto" Margin="12,0,12,12"
              IsVisible="{Binding ShowLibraryToolbar}">
            <TextBox Grid.Column="0" Text="{Binding LibrarySearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Watermark="Search packages" MinHeight="36" Margin="0" VerticalContentAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding LibraryPathText}" Classes="caption" TextTrimming="CharacterEllipsis"
                           Margin="0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding LibraryStatus}" Classes="caption" FontSize="10" Margin="0"
                           IsVisible="{Binding HasLibraryStatus}"/>
            </StackPanel>
            <Button Grid.Column="2" Content="REFRESH" Height="36" Padding="16,0" Margin="0,0,8,0" Click="LibraryRefreshClick"/>
            <Button Grid.Column="3" Content="CHANGE FOLDER" Height="36" Padding="16,0" Click="LibraryChooseClick"/>
        </Grid>

        <!-- Biblioteca: grade de cartões ou estado vazio -->
        <Grid Grid.Row="3" Grid.ColumnSpan="2" Name="LibraryPanel" IsVisible="{Binding ShowLibrary}" Margin="12,0,12,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <!-- Folga em cima: o cartão sobe 2 px no hover e a área de rolagem recortaria a borda da primeira fileira -->
                <ItemsControl ItemsSource="{Binding Library}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Cartão de altura fixa: o botão fica sempre na base e as linhas de texto alinham entre cartões -->
                            <Border Classes="card" Width="280" Height="176" Margin="0,0,12,12" Padding="12"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                <Grid RowDefinitions="*,Auto">
                                    <Grid Grid.Row="0" ColumnDefinitions="64,*">
                                        <Border Width="64" Height="64" VerticalAlignment="Top" ClipToBounds="True"
                                                Background="{DynamicResource SurfaceHoverBrush}">
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3" VerticalAlignment="Top">
                                            <!-- Reserva sempre duas linhas para o título -->
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       MaxLines="2" MinHeight="40" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Top" Margin="0"/>
                                            <TextBlock Text="{Binding Subtitle}" Classes="caption" VerticalAlignment="Top" Margin="0"/>
                                            <TextBlock Text="{Binding Details}" Classes="caption" VerticalAlignment="Top" Margin="0"/>
                                            <!-- Linha de etiquetas sempre reservada -->
                                            <StackPanel Orientation="Horizontal" Spacing="6" MinHeight="22" Margin="0,3,0,0">
                                                <Border Classes="tag" VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSent}" BorderBrush="#4ADE80">
                                                    <TextBlock Text="SENT" Foreground="#4ADE80"/>
                                                </Border>
                                                <Border Classes="tag" VerticalAlignment="Center"
                                                        IsVisible="{Binding Installed}" BorderBrush="#60A5FA">
                                                    <TextBlock Text="{Binding InstalledText}" Foreground="#60A5FA"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                                        <!-- Botões de ação do cartão: estilo e hover próprios (ver Button.card-action em Theme.axaml) -->
                                        <Button Grid.Column="0" Content="OPEN" Classes="card-action" HorizontalAlignment="Stretch"
                                                Click="LibraryItemClick"/>
                                        <Button Grid.Column="1" Content="UNINSTALL" Classes="card-action secondary" Margin="8,0,0,0"
                                                IsVisible="{Binding CanUninstall}" Click="LibraryUninstallClick"
                                                ToolTip.Tip="Remove it from the console"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel IsVisible="{Binding ShowLibraryEmpty}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="16">
                <TextBlock Text="{Binding LibraryEmptyText}" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0"/>
                <Button Content="CHOOSE FOLDER" Classes="primary" Click="LibraryChooseClick" Height="36"
                        Padding="22,0" HorizontalAlignment="Center" IsVisible="{Binding !HasLibraryPath}"/>
            </StackPanel>
        </Grid>

        <!-- Barra do Histórico -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="12,0,12,12"
              IsVisible="{Binding ShowHistory}">
            <TextBlock Grid.Column="0" Text="Packages sent to the console from this PC" Classes="caption"
                       VerticalAlignment="Center" Margin="0"/>
            <Button Grid.Column="1" Content="CLEAR HISTORY" Height="36" Padding="16,0" Click="ClearHistoryClick"
                    IsEnabled="{Binding !ShowHistoryEmpty}"/>
        </Grid>

        <!-- Histórico: um envio por linha -->
        <Grid Grid.Row="3" Grid.ColumnSpan="2" IsVisible="{Binding ShowHistory}" Margin="12,0,12,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid ColumnDefinitions="*,150,100,120">
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0"/>
                                        <TextBlock Text="{Binding Subtitle}" Classes="caption" Margin="0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DateText}" Classes="caption" Margin="0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Classes="caption" Margin="0"/>
                                    <Border Grid.Column="3" Classes="tag" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            BorderBrush="{Binding ResultBrush}">
                                        <TextBlock Text="{Binding Result}" Foreground="{Binding ResultBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock IsVisible="{Binding ShowHistoryEmpty}" Text="No packages sent yet"
                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
        </Grid>

        <Grid Grid.Row="3" Grid.ColumnSpan="2" Name="PreviewGrid" IsVisible="{Binding ShowPackage}" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Image Name="IconBox"></Image>
            <GridSplitter Name="MainGridSplitter" Grid.Column="1"></GridSplitter>

            <!-- Informações do pacote: estado vazio ou cartão com resumo e tabela completa recolhida -->
            <Grid Grid.Column="2" Name="PkgInfoPanel">
                <StackPanel IsVisible="{Binding !HasPkg}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="NO PACKAGE LOADED" Classes="caption" HorizontalAlignment="Center"/>
                    <TextBlock Text="Paste a URL, press Open, or pick a package from the Library"
                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer IsVisible="{Binding HasPkg}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20" Spacing="18">

                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding PkgTitle}" FontSize="22" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0"/>
                            <TextBlock Text="{Binding PkgSubtitle}" Classes="caption" FontSize="12" Margin="0"/>
                        </StackPanel>

                        <Border Classes="tag" HorizontalAlignment="Left" IsVisible="{Binding HasPkgCategory}">
                            <TextBlock Text="{Binding PkgCategory}"/>
                        </Border>

                        <ItemsControl ItemsSource="{Binding PkgDetails}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="170,*" Margin="0,0,0,10">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="caption"
                                                   VerticalAlignment="Top" Margin="0,2,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                   VerticalAlignment="Top" Margin="0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander Header="ALL PARAMETERS" IsExpanded="False" HorizontalAlignment="Stretch">
                            <DataGrid Name="PkgInfoGrid" ItemsSource="{Binding PKGParams}" Height="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Param" Binding="{Binding Name}"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="0,1,0,0" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Name="Status" Classes="caption" Margin="0" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="12,0,0,0"
                            VerticalAlignment="Center" IsVisible="{Binding TransferVisible}">
                    <TextBlock Text="{Binding TransferText}" Classes="caption" Margin="0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="560" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Width="200" Height="6" MinHeight="6" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                 Value="{Binding TransferProgress}" IsIndeterminate="{Binding TransferIndeterminate}"
                                 IsVisible="{Binding TransferShowBar}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="{Binding TransferPauseText}" Height="28" Padding="14,0" Margin="12,0,0,0" FontSize="11"
                        IsVisible="{Binding TransferCanControl}" Click="TogglePauseClick"/>
                <Button Grid.Column="3" Content="CANCEL" Height="28" Padding="14,0" Margin="8,0,0,0" FontSize="11"
                        IsVisible="{Binding CanCancelTransfer}" Click="CancelTransferClick"/>
            </Grid>
        </Border>

        <!-- Toasts: canto inferior direito, acima da barra de estado -->
        <ItemsControl Grid.Row="0" Grid.RowSpan="5" Grid.ColumnSpan="2" ItemsSource="{Binding Toasts}"
                      Width="380" Margin="0,0,16,56" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      ZIndex="100">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="8"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Classes="toast" Background="#1A1A1E" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
                            BoxShadow="0 6 20 0 #90000000">
                        <Grid ColumnDefinitions="3,Auto,*,Auto">
                            <Border Grid.Column="0" Background="{Binding AccentBrush}"/>
                            <Path Grid.Column="1" Data="{Binding Icon}" Stroke="{Binding AccentBrush}" StrokeThickness="1.5"
                                  StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="None"
                                  Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Margin="12,12,4,12" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0"/>
                                <TextBlock Text="{Binding Message}" Classes="caption" TextWrapping="Wrap" Margin="0"
                                           IsVisible="{Binding HasMessage}"/>
                            </StackPanel>
                            <Button Grid.Column="3" Classes="window" Width="32" Height="32" Margin="0,4,4,0"
                                    VerticalAlignment="Top" ToolTip.Tip="Dismiss" Click="ToastCloseClick">
                                <Path Classes="icon" Data="{StaticResource IconClose}"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
    <UserControl.Styles>
        <Style Selector="CheckBox">
            <Setter Property="Width" Value="20"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="0,-6,0,-16"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="Margin" Value="5,0,5,0"></Setter>
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Visible"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
        </Style>
        <Style Selector="MenuItem >> Label">
            <Setter Property="HorizontalAlignment" Value="Right"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="Margin" Value="0,0,5,0"></Setter>
        </Style>
        <Style Selector="MenuItem >> TextBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
            <Setter Property="Width" Value="150"></Setter>
        </Style>
        <Style Selector="MenuItem.NoChildFocus > MenuItem">
            <Setter Property="Focusable" Value="False"></Setter>
            <Setter Property="StaysOpenOnClick" Value="True"></Setter>
        </Style>
    </UserControl.Styles>
</UserControl>
