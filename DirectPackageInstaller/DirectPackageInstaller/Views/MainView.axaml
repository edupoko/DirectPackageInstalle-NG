<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:DirectPackageInstaller.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DirectPackageInstaller.Views.MainView"
             Foreground="White"
             Background="{DynamicResource AppBackgroundBrush}">
  <Design.DataContext>
    <viewModels:MainViewModel />
  </Design.DataContext>
    <Grid Name="MainViewGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Menu Grid.ColumnSpan="2">
            <MenuItem Header="_Options" Name="OptionsMenu">
                <MenuItem Header="_Proxy Downloads" Name="btnProxyDownload">
                    <MenuItem.Icon>
                        <CheckBox BorderThickness="0" IsChecked="{Binding ProxyMode, Mode=TwoWay}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Segmented Downloads" Name="btnSegmentedDownload" >
                    <MenuItem.Icon>
                        <CheckBox BorderThickness="0" IsChecked="{Binding SegmentedMode, Mode=TwoWay}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Transfer Progress" Name="btnTransferProgress" >
                    <MenuItem.Icon>
                        <CheckBox BorderThickness="0" IsChecked="{Binding ShowTransferProgress, Mode=TwoWay}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_CNL Support" Name="btnCNLService" >
                    <MenuItem.Icon>
                        <CheckBox BorderThickness="0" IsChecked="{Binding CNLService, Mode=TwoWay}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_DHCP Server" Name="btnDHCPService" >
                    <MenuItem.Icon>
                        <CheckBox BorderThickness="0" IsChecked="{Binding DHCPService, Mode=TwoWay}"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_IP Address" Classes="NoChildFocus">
                    <StackPanel Orientation="Horizontal">
                        <Label Grid.Column="0">PS IP</Label>
                        <TextBox Grid.Column="1" Text="{Binding PS4IP, Mode=TwoWay}"></TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Grid.Column="0">PC IP</Label>
                        <TextBox Grid.Column="1" Text="{Binding PCIP, Mode=TwoWay}"></TextBox>
                    </StackPanel>
                </MenuItem>
                <MenuItem Header="_Debrids">
                    <MenuItem Header="_AllDebrid" Classes="NoChildFocus">
                        <StackPanel Orientation="Horizontal">
                            <Label Grid.Column="0">API Key</Label>
                            <TextBox Grid.Column="1" Text="{Binding AllDebridApiKey, Mode=TwoWay}" Focusable="True"></TextBox>
                        </StackPanel>
                        <MenuItem Header="_Enabled" Padding="10,10,0,10" Name="btnAllDebirdEnabled">
                            <MenuItem.Icon>
                                <CheckBox BorderThickness="0" IsChecked="{Binding UseAllDebrid, Mode=TwoWay}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="_RealDebrid" Classes="NoChildFocus">
                        <StackPanel Orientation="Horizontal">
                            <Label Grid.Column="0">API Key</Label>
                            <TextBox Grid.Column="1" Text="{Binding RealDebridApiKey, Mode=TwoWay}"></TextBox>
                        </StackPanel>
                        <MenuItem Header="_Enabled" Padding="10,10,0,10" Name="btnRealDebirdEnabled">
                            <MenuItem.Icon>
                                <CheckBox BorderThickness="0" IsChecked="{Binding UseRealDebrid, Mode=TwoWay}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="_DebridLink" Classes="NoChildFocus">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="API Key" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox Width="150" Text="{Binding DebridLinkApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <MenuItem Header="_Enabled" Padding="10,10,0,10" Name="btnDebirdLinkEnabled">
                            <MenuItem.Icon>
                                <CheckBox BorderThickness="0" IsChecked="{Binding UseDebridLink, Mode=TwoWay}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </MenuItem>
                
                <MenuItem Header="_Restart Server" Name="btnRestartServer"/>
                <MenuItem Header="_Exit" Name="btnExit"/>
            </MenuItem>
            <MenuItem Header="Packages" IsVisible="False" Name="PackagesMenu">
                <Separator></Separator>
                <MenuItem Header="Install _All" Name="btnInstallAll"></MenuItem>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="5,0,0,0">URL:</Label>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="5" Text="{Binding CurrentURL, Mode=TwoWay}" Name="tbURL"></TextBox>
            <Button Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" Margin="5,0,5,0" Name="btnLoad" Classes="primary">Open</Button>
        </Grid>


        <!-- Abas: Biblioteca (grade da pasta) e Pacote (detalhes do arquivo carregado) -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="5,2,5,8">
            <Button Classes="tab" Classes.active="{Binding ShowLibrary}" Click="TabLibraryClick" Content="{Binding LibraryTabText}"/>
            <Button Classes="tab" Classes.active="{Binding ShowPackage}" Click="TabPackageClick" Content="PACKAGE"/>
        </StackPanel>

        <!-- Biblioteca -->
        <Grid Grid.Row="3" Grid.ColumnSpan="2" Name="LibraryPanel" IsVisible="{Binding ShowLibrary}"
              RowDefinitions="Auto,*" Margin="5,0,5,0">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,260" Margin="0,0,0,10">
                <TextBlock Grid.Column="0" Text="{Binding LibraryPathText}" Classes="caption"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Grid.Column="1" Content="CHOOSE FOLDER" Click="LibraryChooseClick" Padding="12,6" Margin="0,0,6,0"/>
                <Button Grid.Column="2" Content="REFRESH" Click="LibraryRefreshClick" Padding="12,6" Margin="0,0,6,0"
                        IsEnabled="{Binding HasLibraryPath}"/>
                <TextBox Grid.Column="3" Text="{Binding LibrarySearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Watermark="Search packages" VerticalContentAlignment="Center"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Library}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="280" Margin="0,0,10,10" Padding="12"
                                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="64,*">
                                        <Border Width="64" Height="64" ClipToBounds="True"
                                                Background="{DynamicResource SurfaceHoverBrush}">
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0"/>
                                            <TextBlock Text="{Binding Subtitle}" Classes="caption" Margin="0"/>
                                            <TextBlock Text="{Binding Details}" Classes="caption" Margin="0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="OPEN" Classes="primary" HorizontalAlignment="Stretch"
                                            Padding="0,7" Click="LibraryItemClick"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="1" IsVisible="{Binding ShowLibraryEmpty}" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Spacing="12">
                <TextBlock Text="{Binding LibraryEmptyText}" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"/>
                <Button Content="CHOOSE FOLDER" Classes="primary" Click="LibraryChooseClick" Padding="18,8"
                        HorizontalAlignment="Center" IsVisible="{Binding !HasLibraryPath}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Grid.ColumnSpan="2" Name="PreviewGrid" IsVisible="{Binding ShowPackage}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Image Name="IconBox"></Image>
            <GridSplitter Name="MainGridSplitter" Grid.Column="1"></GridSplitter>

            <!-- Informações do pacote: estado vazio ou cartão com resumo e tabela completa recolhida -->
            <Grid Grid.Column="2" Name="PkgInfoPanel">
                <StackPanel IsVisible="{Binding !HasPkg}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="NO PACKAGE LOADED" Classes="caption" HorizontalAlignment="Center"/>
                    <TextBlock Text="Paste a URL or press Open to choose a .pkg file"
                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer IsVisible="{Binding HasPkg}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20" Spacing="18">

                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding PkgTitle}" FontSize="22" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0"/>
                            <TextBlock Text="{Binding PkgSubtitle}" Classes="caption" FontSize="12" Margin="0"/>
                        </StackPanel>

                        <Border Classes="tag" HorizontalAlignment="Left" IsVisible="{Binding HasPkgCategory}">
                            <TextBlock Text="{Binding PkgCategory}"/>
                        </Border>

                        <ItemsControl ItemsSource="{Binding PkgDetails}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="170,*" Margin="0,0,0,10">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="caption"
                                                   VerticalAlignment="Top" Margin="0,2,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                   VerticalAlignment="Top" Margin="0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander Header="ALL PARAMETERS" IsExpanded="False" HorizontalAlignment="Stretch">
                            <DataGrid Name="PkgInfoGrid" ItemsSource="{Binding PKGParams}" Height="320">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Param" Binding="{Binding Name}"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Grid.Column="0" Name="Status" Classes="caption"/>
    </Grid>
    <UserControl.Styles>
        <Style Selector="CheckBox">
            <Setter Property="Width" Value="20"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Margin" Value="0,-6,0,-16"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="Margin" Value="5,0,5,0"></Setter>
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Visible"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Visible"/>
        </Style>
        <Style Selector="MenuItem >> Label">
            <Setter Property="HorizontalAlignment" Value="Right"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="Margin" Value="0,0,5,0"></Setter>
        </Style>
        <Style Selector="MenuItem >> TextBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="VerticalContentAlignment" Value="Center"></Setter>
            <Setter Property="Width" Value="150"></Setter>
        </Style>
        <Style Selector="MenuItem.NoChildFocus > MenuItem">
            <Setter Property="Focusable" Value="False"></Setter>
            <Setter Property="StaysOpenOnClick" Value="True"></Setter>
        </Style>
    </UserControl.Styles>
</UserControl>
